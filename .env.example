# Sphinx is fully playable with NO keys set. Every variable here is an optional upgrade.
# See PROJECT_CONTEXT.md §5 - the demo must never depend on a paid service.

# --- Tinker (Thinking Machines). Only needed for the fine-tuned riddle model at hunt-build time.
# Get a key: https://tinker.thinkingmachines.ai/keys?new_key=true
TINKER_API_KEY=

# LoRA checkpoint to use as the riddle writer. Leave blank to use the template generator,
# which is the guaranteed-working demo path.
SPHINX_RIDDLE_MODEL=

# --- OSM. These have working defaults in src/lib/config.ts.
# Overpass and Nominatim BOTH reject placeholder domains in the User-Agent (403/429).
# Set these to your real contact before going anywhere near production.
SPHINX_CONTACT_URL=https://github.com/your-handle/sphinx
SPHINX_CONTACT_EMAIL=you@example.com

# Optional: override endpoints. Never hardcode these in source - they churn and they rate-limit.
SPHINX_OVERPASS_URL=
SPHINX_NOMINATIM_URL=